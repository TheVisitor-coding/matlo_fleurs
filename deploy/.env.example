# Copier en deploy/.env puis renseigner les valeurs réelles. Ne jamais committer .env.
# Le compte se crée dans le manager Infomaniak, menu FTP / SSH.

SSH_HOTE=qw0z78.ftp.infomaniak.com
SSH_UTILISATEUR=
# Relatif au répertoire personnel du compte SSH. Slash final obligatoire.
CHEMIN_DISTANT=sites/matlofleurs.fr/
SSH_PORT=22
# Clé privée dédiée au déploiement, en ed25519 : Infomaniak refuse RSA.
SSH_CLE=~/.ssh/matlofleurs_ci
