---
import { Font } from 'astro:assets';
import { site } from '../data/site';
import { florist } from '../lib/schema';
import '../styles/base.css';

interface Props {
  titre: string;
  description: string;
  /** Sans slash final, `/` pour l'accueil. */
  chemin: string;
  /** Le balisage Florist ne vit que sur la page d'accueil. */
  donneesStructurees?: boolean;
  noindex?: boolean;
}

const { titre, description, chemin, donneesStructurees = false, noindex = false } = Astro.props;

const canonique = new URL(chemin, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;
// Une URL absolue est obligatoire : les réseaux ne résolvent pas les chemins relatifs.
const partage = new URL('/og-image.png', Astro.site).href;
const schema = donneesStructurees ? florist(canonique) : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={partage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nom}, ${site.metier}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d1e33" />

    {/* Seules les polices du titre du hero sont préchargées : les précharger
        toutes ferait de la typographie le goulot du LCP. */}
    <Font cssVariable="--police-titre" preload />
    <Font cssVariable="--police-accent" preload />
    <Font cssVariable="--police-corps" />
    <Font cssVariable="--police-label" />
    <Font cssVariable="--police-logotype" />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
