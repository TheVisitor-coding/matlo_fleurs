---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import EtoileSurtitre from '../assets/etoile-surtitre.svg';

interface Props {
  surtitre: string;
  titre: string;
  image: ImageMetadata;
  alt: string;
  cote?: 'gauche' | 'droite';
  hauteurImage: number;
  /** La maquette titre à 38 px sur l'atelier et 36 px sur la livraison. */
  tailleTitre?: string;
  id?: string | undefined;
}

const {
  surtitre,
  titre,
  image,
  alt,
  cote = 'gauche',
  hauteurImage,
  tailleTitre = 'var(--taille-h2-bloc)',
  id,
} = Astro.props;
---

<section class={`bloc bloc--image-${cote}`} id={id} style={`--taille-titre: ${tailleTitre}`}>
  <div class="bloc__wrapper">
    <div class="bloc__visuel" data-reveal style={`--hauteur-image: ${hauteurImage}px`}>
      <Image
        class="bloc__image"
        src={image}
        alt={alt}
        width={1216}
        widths={[608, 1216]}
        sizes="(max-width: 899px) 92vw, 608px"
        loading="lazy"
      />
    </div>

    <div class="bloc__texte" data-reveal style="--reveal-index:1">
      <p class="label bloc__surtitre">
        <EtoileSurtitre class="bloc__etoile" aria-hidden="true" />
        {surtitre}
      </p>
      <h2 class="bloc__titre">{titre}</h2>
      <div class="bloc__corps"><slot /></div>
      <slot name="cta" />
    </div>
  </div>
</section>

<style>
  .bloc {
    padding-block: var(--espace-6);
    background: var(--fond-creme);
  }

  .bloc__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--espace-3);
    max-width: var(--largeur-contenu);
    margin-inline: auto;
    padding-inline: var(--espace-5);
  }

  .bloc--image-droite .bloc__visuel {
    order: 2;
  }

  .bloc__visuel {
    height: var(--hauteur-image);
    border-radius: 8px;
    overflow: hidden;
  }

  .bloc__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bloc__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .bloc__surtitre {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    max-width: none;
    font-size: var(--taille-surtitre);
  }

  .bloc__etoile {
    flex: none;
    width: 12px;
    height: 12px;
  }

  .bloc__titre {
    font-size: var(--taille-titre);
  }

  .bloc__corps > :global(p) {
    margin: 0 0 var(--espace-2);
    max-width: none;
    font-size: var(--taille-carte);
  }

  .bloc__corps > :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 899px) {
    .bloc__wrapper {
      grid-template-columns: 1fr;
      gap: var(--espace-4);
      padding-inline: var(--espace-3);
    }

    .bloc--image-droite .bloc__visuel {
      order: 0;
    }

    .bloc__visuel {
      height: auto;
      max-height: var(--hauteur-image);
    }
  }
</style>
