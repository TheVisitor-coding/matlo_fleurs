---
import TitreSection from './TitreSection.astro';
import Feuillage from '../assets/feuillage.svg';
---

<section class="bandeau">
  <Feuillage class="bandeau__feuillage bandeau__feuillage--gauche" aria-hidden="true" />
  <div class="bandeau__wrapper">
    <TitreSection
      ligne1="Pour toutes les occasions,"
      ligne2="rien que pour vous"
      styleLigne2="script"
      inverse
    />
  </div>
  <Feuillage class="bandeau__feuillage bandeau__feuillage--droite" aria-hidden="true" />
</section>

<style>
  .bandeau {
    position: relative;
    overflow: hidden;
    padding-block: var(--espace-6);
    background: var(--fond-inverse);
  }

  .bandeau__wrapper {
    position: relative;
    z-index: 1;
    max-width: var(--largeur-contenu);
    margin-inline: auto;
    padding-inline: var(--espace-5);
  }

  .bandeau :global(.titre-section span:first-child) {
    font-size: var(--taille-h2-bandeau);
  }

  .bandeau :global(.accent) {
    font-size: var(--taille-accent-bandeau);
    line-height: 0.8;
  }

  /* Un seul dessin, retourné pour le côté droit. */
  .bandeau__feuillage {
    position: absolute;
    width: 87px;
    height: 311px;
    color: var(--couleur-sauge);
    pointer-events: none;
  }

  .bandeau__feuillage--gauche {
    top: 70px;
    left: -24px;
    rotate: 74.3deg;
    transform-origin: center;
  }

  .bandeau__feuillage--droite {
    top: -14px;
    right: -24px;
    rotate: -105.7deg;
    transform-origin: center;
  }

  @media (max-width: 1023px) {
    .bandeau__wrapper {
      padding-inline: var(--espace-3);
    }

    .bandeau__feuillage {
      display: none;
    }
  }
</style>
