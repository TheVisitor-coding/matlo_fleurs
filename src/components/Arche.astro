---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  variante?: 'hero' | 'carte';
  /** À activer sur l'image du hero, candidate au LCP. */
  priorite?: boolean;
  /** Largeur de rendu de l'image, quand le parent contraint la largeur. */
  largeurRendu?: number;
  sizes?: string;
}

const {
  src,
  alt,
  variante = 'carte',
  priorite = false,
  largeurRendu,
  sizes = '(max-width: 1023px) 85vw, 380px',
} = Astro.props;

const largeur = largeurRendu ?? (variante === 'hero' ? 380 : 361);
---

<figure class={`arche arche--${variante}`}>
  <div class="arche__cadre">
    <Image
      class="arche__image"
      src={src}
      alt={alt}
      width={largeur * 2}
      widths={[largeur, largeur * 2]}
      sizes={sizes}
      loading={priorite ? 'eager' : 'lazy'}
      fetchpriority={priorite ? 'high' : 'auto'}
    />
  </div>
</figure>

<style>
  /* Le rayon de la maquette est constant à 180 px, pas proportionnel : sur une
     arche de 361 px il forme un dôme exactement semi-circulaire, sur celle de
     380 px il laisse un méplat au sommet. Le min() reprend cette intention en
     préservant la forme quand la largeur tombe sous 360 px. */
  .arche {
    --arche-rayon: min(180px, 50%);

    margin: 0;
    width: 100%;
    max-width: var(--arche-largeur, 100%);
    padding: 4px;
    border: var(--arche-filet) solid var(--couleur-nuit);
    border-radius: calc(var(--arche-rayon) + 4px) calc(var(--arche-rayon) + 4px) 0 0;
  }

  .arche--hero {
    --arche-largeur: var(--arche-hero);
  }

  .arche__cadre {
    border: var(--arche-filet) solid var(--couleur-sauge);
    border-radius: var(--arche-rayon) var(--arche-rayon) 0 0;
    overflow: hidden;
    aspect-ratio: var(--arche-ratio-carte);
  }

  .arche--hero .arche__cadre {
    aspect-ratio: var(--arche-ratio-hero);
  }

  .arche__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
