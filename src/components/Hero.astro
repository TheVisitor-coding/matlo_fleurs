---
import Arche from './Arche.astro';
import Bouton from './Bouton.astro';
import EtoileSurtitre from '../assets/etoile-surtitre.svg';
import EtoileInfo from '../assets/etoile-info.svg';
import Tulipe from '../assets/tulipe.svg';
import photo from '../assets/hero-photo.png';
import { site } from '../data/site';

const atouts = [
  'Fleurs de saison',
  'Sur-mesure',
  'Livraison locale',
  'Envoi partout en France',
];

const telephone = site.telephone.lien ? `tel:${site.telephone.lien}` : undefined;
---

<section class="hero">
  <div class="hero__wrapper">
    <div class="hero__texte">
      <p class="label hero__surtitre">
        <EtoileSurtitre class="hero__etoile-surtitre" aria-hidden="true" />
        Artisan fleuriste à Challans
      </p>

      <h1 class="hero__titre">
        <span class="hero__titre-ligne">Des compositions florales,</span>{' '}
        <span class="hero__titre-accent">
          <span class="hors-ecran">façonnées à la main</span>
          <picture>
            {/* L'animation est en SMIL, que le CSS n'atteint pas : le mouvement
                réduit passe donc par une seconde image, déjà tracée. */}
            <source srcset="/signature-statique.svg" media="(prefers-reduced-motion: reduce)" />
            <img
              class="hero__signature"
              src="/signature.svg"
              alt=""
              width="467"
              height="99"
              fetchpriority="high"
            />
          </picture>
        </span>
      </h1>

      <p class="hero__chapo">
        Au {site.adresse.ligne1}, à {site.adresse.ville}, nous composons chaque jour des
        bouquets, des compositions et des créations en fleurs séchées, au rythme des saisons.
        Pour un mariage, un deuil ou simplement pour le plaisir d'offrir.
      </p>

      <div class="hero__actions">
        <Bouton href={site.ancres.creations} pleineLargeur>Découvrir nos créations</Bouton>
        <Bouton variante="secondaire" href={telephone} pleineLargeur>
          {site.telephone.affiche}
        </Bouton>
      </div>

      <hr class="hero__filet" />

      <ul class="hero__atouts">
        {
          atouts.map((atout) => (
            <li class="hero__atout">
              <EtoileInfo class="hero__etoile-info" aria-hidden="true" />
              {atout}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visuel">
      <Arche
        variante="hero"
        priorite
        sizes="(max-width: 1023px) 85vw, 380px"
        src={photo}
        alt="Fleuriste composant un bouquet de tulipes et de renoncules dans l'atelier de Challans"
      />
    </div>
  </div>

  <Tulipe class="hero__tulipe" aria-hidden="true" />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--espace-6);
    background: var(--fond-creme);
  }

  .hero__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--espace-3);
    max-width: var(--largeur-page);
    margin-inline: auto;
    padding-inline: var(--espace-5);
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    gap: var(--espace-3);
    /* Référence du `cqw` de la ligne 1 du titre, qui doit tenir sur une ligne à
       une largeur que la maquette ne décrit qu'en 1440. */
    container-type: inline-size;
  }

  .hero__surtitre {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    max-width: none;
    font-size: var(--taille-surtitre);
  }

  .hero__etoile-surtitre {
    flex: none;
    width: 12px;
    height: 12px;
  }

  .hero__titre {
    display: flex;
    flex-direction: column;
  }

  /* La maquette ne met aucun interlettrage sur cette ligne, contrairement à la
     règle globale des titres : les 0.06em lui coûtent 62 px et la font passer
     sur deux lignes. Le `min()` la fait suivre la colonne en dessous de la
     largeur de maquette plutôt que de casser : 580 px mesurés pour 40 px de
     corps, soit 6.9 % de la colonne, arrondi en dessous. */
  .hero__titre-ligne {
    letter-spacing: normal;
    font-size: min(var(--taille-h1), 6.85cqw);
  }

  .hero__titre-accent picture {
    display: block;
  }

  /* Chorégraphie d'entrée. .hero__visuel en est exclu à dessein : l'arche porte
     fetchpriority=high, c'est le candidat LCP, et une opacité nulle en
     retarderait la mesure d'autant. */
  @keyframes hero-entree {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  .hero__surtitre,
  .hero__titre-ligne,
  .hero__chapo,
  .hero__actions,
  .hero__filet,
  .hero__atouts {
    animation: hero-entree var(--duree-longue) var(--easing-sortie) backwards;
  }

  .hero__titre-ligne {
    animation-delay: 80ms;
  }

  .hero__chapo {
    animation-delay: 160ms;
  }

  .hero__actions {
    animation-delay: 240ms;
  }

  .hero__filet {
    animation-delay: 320ms;
  }

  .hero__atouts {
    animation-delay: 400ms;
  }

  /* `npm run signature` recadre le SVG au plus près de l'encre et affiche la
     valeur à reporter ici : 467.01 unités de large pour un corps de 100, soit
     4.6701em. Le vide d'interligne ayant quitté le fichier, il n'y a plus de
     marge négative à lui opposer. */
  .hero__signature {
    font-size: var(--taille-accent);
    width: min(100%, 4.6701em);
    height: auto;
  }

  .hero__chapo {
    margin: 0;
    /* La maquette lui donne toute la colonne ; le `68ch` global des paragraphes
       la briserait avant. */
    max-width: none;
    font-size: var(--taille-corps);
  }

  .hero__actions {
    display: flex;
    gap: 10px;
  }

  .hero__filet {
    width: 100%;
    height: 2px;
    margin: 0;
    border: 0;
    border-radius: 1000px;
    background: var(--couleur-sauge);
  }

  .hero__atouts {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    /* 16 px est la valeur de la maquette, et c'est un minimum que
       `space-between` ne peut pas descendre : à 24 px les quatre items ne
       tiennent plus sur une ligne. */
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__atout {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: var(--famille-label);
    font-size: var(--taille-label);
    color: var(--texte-accent);
  }

  .hero__etoile-info {
    flex: none;
    width: 14px;
    height: 14px;
  }

  .hero__visuel {
    display: flex;
    justify-content: center;
  }

  .hero__tulipe {
    position: absolute;
    right: var(--espace-5);
    bottom: 0;
    width: 67px;
    height: 174px;
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .hero__wrapper {
      grid-template-columns: 1fr;
      gap: var(--espace-4);
      padding-inline: var(--espace-3);
    }

    .hero__atouts {
      justify-content: flex-start;
    }

    .hero__tulipe {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
    }

    .hero__atouts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
