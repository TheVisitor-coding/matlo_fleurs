---
import Arche from './Arche.astro';
import Bouton from './Bouton.astro';
import EtoileSurtitre from '../assets/etoile-surtitre.svg';
import EtoileInfo from '../assets/etoile-info.svg';
import Tulipe from '../assets/tulipe.svg';
import photo from '../assets/hero-photo.png';
import { site } from '../data/site';

const atouts = [
  'Fleurs de saison',
  'Sur-mesure',
  'Livraison locale',
  'Envoi partout en France',
];

const telephone = site.telephone.lien ? `tel:${site.telephone.lien}` : undefined;
---

<section class="hero">
  <div class="hero__wrapper">
    <div class="hero__texte">
      <p class="label hero__surtitre">
        <EtoileSurtitre class="hero__etoile-surtitre" aria-hidden="true" />
        Artisan fleuriste à Challans
      </p>

      <h1 class="hero__titre">
        <span>Des compositions florales,</span>
        <span class="accent hero__titre-accent">façonnées à la main</span>
      </h1>

      <p class="hero__chapo">
        Au {site.adresse.ligne1}, à {site.adresse.ville}, nous composons chaque jour des
        bouquets, des compositions et des créations en fleurs séchées, au rythme des saisons.
        Pour un mariage, un deuil ou simplement pour le plaisir d'offrir.
      </p>

      <div class="hero__actions">
        <Bouton href={site.ancres.creations} pleineLargeur>Découvrir nos créations</Bouton>
        <Bouton variante="secondaire" href={telephone} pleineLargeur>
          {site.telephone.affiche}
        </Bouton>
      </div>

      <hr class="hero__filet" />

      <ul class="hero__atouts">
        {
          atouts.map((atout) => (
            <li class="hero__atout">
              <EtoileInfo class="hero__etoile-info" aria-hidden="true" />
              {atout}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visuel">
      <Arche
        variante="hero"
        priorite
        sizes="(max-width: 1023px) 85vw, 380px"
        src={photo}
        alt="Fleuriste composant un bouquet de tulipes et de renoncules dans l'atelier de Challans"
      />
    </div>
  </div>

  <Tulipe class="hero__tulipe" aria-hidden="true" />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--espace-6);
    background: var(--fond-creme);
  }

  .hero__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--espace-5);
    max-width: var(--largeur-contenu);
    margin-inline: auto;
    padding-inline: var(--espace-5);
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    gap: var(--espace-3);
  }

  .hero__surtitre {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    max-width: none;
    font-size: var(--taille-surtitre);
  }

  .hero__etoile-surtitre {
    flex: none;
    width: 12px;
    height: 12px;
  }

  .hero__titre {
    display: flex;
    flex-direction: column;
  }

  .hero__titre-accent {
    /* Le script déborde de sa boîte de ligne, une marge négative rattrape le
       creux que laisserait l'interligne nominal. */
    margin-top: -0.15em;
  }

  .hero__chapo {
    margin: 0;
    font-size: var(--taille-corps);
  }

  .hero__actions {
    display: flex;
    gap: 10px;
  }

  .hero__filet {
    width: 100%;
    height: 2px;
    margin: 0;
    border: 0;
    border-radius: 1000px;
    background: var(--couleur-sauge);
  }

  .hero__atouts {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espace-2) var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__atout {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--famille-label);
    font-size: var(--taille-label);
    color: var(--texte-accent);
  }

  .hero__etoile-info {
    flex: none;
    width: 14px;
    height: 14px;
  }

  .hero__visuel {
    display: flex;
    justify-content: center;
  }

  .hero__tulipe {
    position: absolute;
    right: var(--espace-5);
    bottom: 0;
    width: 67px;
    height: 174px;
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .hero__wrapper {
      grid-template-columns: 1fr;
      gap: var(--espace-4);
      padding-inline: var(--espace-3);
    }

    .hero__atouts {
      justify-content: flex-start;
    }

    .hero__tulipe {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
    }

    .hero__atouts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
