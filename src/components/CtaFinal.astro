---
import { Image } from 'astro:assets';
import Bouton from './Bouton.astro';
import FormulaireContact from './FormulaireContact.astro';
import { site } from '../data/site';
import photoBanniere from '../assets/cta-4.png';

const telephone = site.telephone.lien;
---

<section class="cta" id={site.ancres.contact.slice(1)}>
  <div class="cta__banniere" data-reveal>
    <Image
      class="cta__photo"
      src={photoBanniere}
      alt=""
      width={1336}
      widths={[668, 1336]}
      sizes="(max-width: 1023px) 100vw, 1336px"
      loading="lazy"
      aria-hidden="true"
    />

    <div class="cta__contenu">
      <h2 class="cta__titre">Une envie, une date, une question ?</h2>
      <p class="cta__sous-titre">
        Passez à la boutique, ou appelez-nous. On compose avec vous.
      </p>

      <div class="cta__actions">
        <Bouton taille="moyenne" href={telephone}>Nous appeler</Bouton>
        <Bouton variante="secondaire" inverse taille="moyenne" href="#formulaire">
          Nous écrire
        </Bouton>
      </div>
    </div>
  </div>

  <div class="cta__formulaire" data-reveal style="--reveal-index:1">
    <p class="label cta__surtitre">Nous écrire</p>
    <FormulaireContact />
  </div>
</section>

<style>
  .cta {
    padding-block: var(--espace-6);
  }

  .cta__banniere {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 460px;
    max-width: var(--largeur-page);
    margin-inline: auto;
    border-radius: 24px;
  }

  .cta__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Voile nécessaire au contraste : la photo seule ne garantit pas la
     lisibilité du texte clair, quel que soit son cadrage. */
  .cta__banniere::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(29 30 51 / 0.5) 0%, rgb(29 30 51 / 0.82) 100%);
  }

  .cta__contenu {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espace-3);
    max-width: 640px;
    padding-inline: var(--espace-4);
    text-align: center;
  }

  .cta__titre {
    color: var(--couleur-blanc);
    font-size: var(--taille-h2-cta);
  }

  .cta__sous-titre {
    margin: 0;
    max-width: none;
    color: var(--couleur-creme);
    font-weight: var(--graisse-normale);
    font-size: var(--taille-sous-titre);
  }

  .cta__actions {
    display: flex;
    gap: 10px;
  }

  .cta__formulaire {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espace-2);
    max-width: var(--largeur-page);
    margin-inline: auto;
    padding-top: var(--espace-7);
    padding-inline: var(--espace-5);
  }

  .cta__surtitre {
    margin: 0;
  }

  @media (max-width: 1023px) {
    .cta__banniere {
      margin-inline: var(--espace-3);
      min-height: 380px;
    }

    .cta__formulaire {
      padding-top: var(--espace-6);
      padding-inline: var(--espace-3);
    }
  }

  @media (max-width: 560px) {
    .cta__banniere {
      min-height: 0;
      padding-block: var(--espace-5);
    }

    .cta__actions {
      flex-direction: column;
      width: 100%;
    }
  }
</style>
